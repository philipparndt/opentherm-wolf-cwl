# Copy this file to .env and fill in your values.
# Loaded by the Makefile via `-include .env`; values are also exported to the
# build environment, so build.rs bakes the WiFi credentials into the firmware
# as a fallback when NVS has no stored credentials.
#
# Avoid quotes and Make-special characters (#, $) — this file is parsed as
# Makefile syntax, not as a shell-style .env.

WIFI_SSID=your-network-name
WIFI_PASSWORD=your-network-password

# Optional: override the serial port for flash/monitor. Find yours with
# `ls /dev/cu.*` while the ESP32 is plugged in.
# PORT=/dev/cu.usbserial-110
